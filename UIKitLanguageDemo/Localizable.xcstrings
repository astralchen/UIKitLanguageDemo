    "home.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首页"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرئيسية"
          }
        }
      }
    },
    "home.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the detail screen, enter a draft, then switch languages without leaving the screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开详情页、输入草稿，然后留在当前页面切换语言。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح صفحة التفاصيل، واكتب مسودة، ثم غيّر اللغة دون مغادرة الصفحة."
          }
        }
      }
    },

    "detail.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch languages below. Your current screen, navigation stack, and draft stay in place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方切换语言，当前页面、导航栈和草稿会保留。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غيّر اللغة أدناه. ستبقى الصفحة الحالية وسجل التنقل والمسودة كما هي."
          }
        }
      }
    },
